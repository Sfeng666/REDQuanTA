# HTCondor submit file for batch neutral ABC QST estimation
# Processes multiple FST values in a single job for efficiency
# Supports multiple summary stat combinations when combos_file is provided

universe = vanilla
executable = $(dir_scripts)/run_abc_qst.sh
arguments = batch_neutral $(fst_input) $(ratioVext) $(output_file) $(num_sim) $(summary_stats)
environment = "$(environment)"

# Transfer R script, FST batch file, environment, and optional combos file
# Note: combos_file is included in the comma-separated list when provided
# Use fst_input (basename); initialdir is $(outdir) where batch files live
transfer_input_files = $(dir_code)/qst_abc_sim.R, $(dir_code)/abc_fast_estimators.R, $(fst_input), $(r_env_tarball)$(extra_input_files)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = $(output_file)

initialdir = $(outdir)
log = $(job).log
output = $(job).out
error = $(job).err

# Resource requests - optimized for parallel execution
request_cpus = 4
request_memory = 2GB
request_disk = 2GB

# Auto-retry memory holds only; transfer holds -> CHTC via monitor_ospool_fallback.sh
periodic_release = (NumJobStarts < 5) && (HoldReasonCode == 21)

want_campus_pools = true
want_ospool = true
requirements = (Target.OpSysMajorVer >= 7)

queue
