# Per-DAG CONFIG (not global condor_config). Schedd defaults on ap2001 (2026-05-28):
#   DAGMAN_MAX_JOBS_IDLE=1000, DAGMAN_MAX_SUBMITS_PER_INTERVAL=100
# Raised below for short high-throughput flat-DAG runs. For a running DAGman,
# also: condor_qedit <cluster>.0 'DAGMan_MaxIdle = 5000' ...

DAGMAN_MAX_JOBS_IDLE = 10000
DAGMAN_MAX_JOBS_SUBMITTED = 0
DAGMAN_MAX_SUBMITS_PER_INTERVAL = 1000
DAGMAN_USER_LOG_SCAN_INTERVAL = 5
